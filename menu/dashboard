<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#030712">
    <title>Admin Panel · SPPG Bantaeng Gantarangkeke 1</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: { 800: '#0f172a', 900: '#090d16', 950: '#030712' },
                        royal: { 400: '#38bdf8', 500: '#0284c7', 600: '#0369a1', 700: '#075985' }
                    },
                    fontFamily: { sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'] }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(56, 189, 248, 0.12);
        }
        .glass-input {
            background: rgba(3, 7, 18, 0.6);
            border: 1px solid rgba(56, 189, 248, 0.2);
            color: white;
        }
        .glass-input:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.15);
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(3, 7, 18, 0.8); }
        ::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.25); border-radius: 9999px; }
    </style>
</head>
<body class="bg-slate-950 font-sans text-slate-200 antialiased min-h-full flex flex-col selection:bg-royal-500 selection:text-white">

    <!-- Ambient Background Glows -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-royal-700/15 rounded-full blur-3xl"></div>
        <div class="absolute top-1/3 -right-40 w-96 h-96 bg-sky-600/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 flex-1 flex flex-col max-w-4xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10">
        
        <!-- Header -->
        <header class="glass-panel rounded-3xl p-6 mb-6 shadow-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <span class="px-3 py-1 rounded-full bg-royal-500/10 border border-royal-400/20 text-royal-400 text-xs font-bold uppercase tracking-wider">
                    Admin Dashboard
                </span>
                <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mt-2">Input & Kelola Menu Harian</h1>
                <p class="text-xs sm:text-sm text-slate-400">SPPG Bantaeng Gantarangkeke 1</p>
            </div>
            <a href="index.html" target="_blank" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-royal-500/40 text-xs font-bold transition">
                <svg class="w-4 h-4 text-royal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span>Lihat Website Menu</span>
            </a>
        </header>

        <!-- Form Panel -->
        <main class="glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl">
            <form id="form-menu" class="space-y-6">
                
                <!-- Konfigurasi GitHub & Token (Untuk Upload Gambar) -->
                <div class="p-4 rounded-2xl bg-slate-900/80 border border-royal-500/30 space-y-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-royal-400">Konfigurasi GitHub Upload</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">GitHub Personal Access Token (PAT)</label>
                            <input type="password" id="gh-token" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-xs">
                            <p class="text-[10px] text-slate-500 mt-1">Token disimpan otomatis di browser Anda (localStorage).</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Target Folder Repo</label>
                            <input type="text" id="gh-path" value="assets/menu" readonly class="w-full px-3.5 py-2.5 rounded-xl glass-input text-xs text-slate-400 bg-slate-950">
                        </div>
                    </div>
                </div>

                <!-- Informasi Dasar -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Tanggal Sajian *</label>
                        <input type="date" id="tanggal" required class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Nama SPPG</label>
                        <input type="text" id="nama_sppg" value="SPPG Bantaeng Gantarangkeke 1" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Yayasan</label>
                        <input type="text" id="yayasan" value="Yayasan Tunas Ilmu Bantaeng" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                    </div>
                </div>

                <!-- Susunan Menu Makanan -->
                <div class="border-t border-slate-800/80 pt-5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-royal-400 mb-4">Susunan Menu Ompreng</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Makanan Pokok</label>
                            <input type="text" id="makanan_pokok" placeholder="Contoh: Nasi Putih" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Lauk Hewani</label>
                            <input type="text" id="lauk_hewani" placeholder="Contoh: Ayam Goreng Lengkuas" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Lauk Nabati</label>
                            <input type="text" id="lauk_nabati" placeholder="Contoh: Tahu & Tempe Goreng" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Sayur Segar</label>
                            <input type="text" id="sayur" placeholder="Contoh: Sayur Bening Bayam" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Buah-Buahan</label>
                            <input type="text" id="buah" placeholder="Contoh: Pisang / Jeruk" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Pelengkap</label>
                            <input type="text" id="pelengkap" placeholder="Contoh: Kerupuk & Air Mineral" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm">
                        </div>
                    </div>
                </div>

                <!-- Upload Foto Dokumentasi ke GitHub -->
                <div class="border-t border-slate-800/80 pt-5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-royal-400 mb-3">Dokumentasi Foto Menu</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                        <div>
                            <input type="file" id="file-foto" accept="image/*" class="w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-royal-600 file:text-white hover:file:bg-royal-500 cursor-pointer">
                            <button type="button" id="btn-upload" onclick="uploadKeGitHub()" class="mt-3 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-white transition">
                                🚀 Upload Gambar ke GitHub
                            </button>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">URL Foto Utama</label>
                            <input type="text" id="foto" placeholder="https://..." class="w-full px-3.5 py-2.5 rounded-xl glass-input text-xs">
                        </div>
                    </div>
                </div>

                <!-- Kandungan Nilai Gizi -->
                <div class="border-t border-slate-800/80 pt-5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-royal-400 mb-4">Kandungan Nilai Gizi Per Porsi</h3>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <!-- Porsi Kecil (PK) -->
                        <div class="p-4 rounded-2xl bg-slate-900/50 border border-slate-800 space-y-3">
                            <div class="font-bold text-xs text-white uppercase">Porsi Kecil (PAUD - SD Kelas 3)</div>
                            <div class="grid grid-cols-2 gap-2">
                                <div><label class="text-[10px] text-slate-400">Energi (kkal)</label><input type="number" step="any" id="pk-energi" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Protein (g)</label><input type="number" step="any" id="pk-protein" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Lemak (g)</label><input type="number" step="any" id="pk-lemak" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Karbohidrat (g)</label><input type="number" step="any" id="pk-karbohidrat" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                            </div>
                            <div><label class="text-[10px] text-slate-400">Serat (g)</label><input type="number" step="any" id="pk-serat" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                        </div>

                        <!-- Porsi Besar (PB) -->
                        <div class="p-4 rounded-2xl bg-slate-900/50 border border-slate-800 space-y-3">
                            <div class="font-bold text-xs text-royal-400 uppercase">Porsi Besar (SD Kelas 4 - SMA)</div>
                            <div class="grid grid-cols-2 gap-2">
                                <div><label class="text-[10px] text-slate-400">Energi (kkal)</label><input type="number" step="any" id="pb-energi" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Protein (g)</label><input type="number" step="any" id="pb-protein" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Lemak (g)</label><input type="number" step="any" id="pb-lemak" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                                <div><label class="text-[10px] text-slate-400">Karbohidrat (g)</label><input type="number" step="any" id="pb-karbohidrat" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                            </div>
                            <div><label class="text-[10px] text-slate-400">Serat (g)</label><input type="number" step="any" id="pb-serat" class="w-full px-3 py-2 rounded-lg glass-input text-xs"></div>
                        </div>
                    </div>
                </div>

                <!-- Catatan Tambahan -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Catatan Tambahan (Opsional)</label>
                    <textarea id="catatan" rows="2" placeholder="Catatan khusus untuk menu hari ini..." class="w-full px-3.5 py-2.5 rounded-xl glass-input text-sm"></textarea>
                </div>

                <!-- Tombol Submit -->
                <div class="pt-4 flex items-center justify-end gap-3">
                    <button type="submit" id="btn-submit" class="px-6 py-3 rounded-2xl bg-gradient-to-r from-royal-600 to-sky-500 hover:from-royal-500 hover:to-sky-400 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-royal-600/30 transition">
                        Simpan Menu ke Database
                    </button>
                </div>

                <div id="status-msg" class="hidden text-xs text-center p-3 rounded-xl"></div>
            </form>
        </main>
    </div>

    <script>
        // Set tanggal default hari ini
        document.getElementById('tanggal').value = new Date().toISOString().split('T')[0];

        // Muat token tersimpan jika ada
        const savedToken = localStorage.getItem('gh_token_sppg');
        if (savedToken) {
            document.getElementById('gh-token').value = savedToken;
        }

        // Fungsi Upload Gambar ke GitHub
        async function uploadKeGitHub() {
            const token = document.getElementById('gh-token').value.trim();
            const fileInput = document.getElementById('file-foto');
            const statusMsg = document.getElementById('status-msg');

            if (!token) {
                alert('Masukkan GitHub Personal Access Token terlebih dahulu!');
                return;
            }
            if (fileInput.files.length === 0) {
                alert('Pilih file gambar terlebih dahulu!');
                return;
            }

            // Simpan token ke localStorage
            localStorage.setItem('gh_token_sppg', token);

            const file = fileInput.files[0];
            const reader = new FileReader();

            statusMsg.className = 'text-xs text-center p-3 rounded-xl bg-royal-500/10 text-royal-400 block';
            statusMsg.textContent = 'Mengunggah gambar ke GitHub...';

            reader.onload = async function() {
                try {
                    // Ambil base64 content tanpa header data:image/...
                    const base64Content = reader.result.split(',')[1];
                    const fileName = 'menu_' + Date.now() + '_' + file.name.replace(/\s+/g, '_');
                    const repoOwner = 'yosdniel';
                    const repoName = 'yosdniel.github.io';
                    const filePath = 'assets/menu/' + fileName;

                    const url = `https://api.github.com/repos/${repoOwner}/${repoName}/contents/${filePath}`;

                    const response = await fetch(url, {
                        method: 'PUT',
                        headers: {
                            'Authorization': `token ${token}`,
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            message: `Upload foto menu ${fileName}`,
                            content: base64Content
                        })
                    });

                    const result = await response.json();

                    if (response.ok) {
                        // URL raw file di GitHub Pages / Raw
                        const downloadUrl = `https://raw.githubusercontent.com/${repoOwner}/${repoName}/main/${filePath}`;
                        document.getElementById('foto').value = downloadUrl;
                        
                        statusMsg.className = 'text-xs text-center p-3 rounded-xl bg-emerald-500/10 text-emerald-400 block';
                        statusMsg.textContent = 'Berhasil mengunggah gambar ke GitHub!';
                    } else {
                        throw new Error(result.message || 'Gagal upload ke GitHub');
                    }
                } catch (err) {
                    statusMsg.className = 'text-xs text-center p-3 rounded-xl bg-red-500/10 text-red-400 block';
                    statusMsg.textContent = 'Gagal Upload: ' + err.message;
                }
            };
            reader.readAsDataURL(file);
        }

        // Submit Form ke API Supabase
        document.getElementById('form-menu').addEventListener('submit', async function(e) {
            e.preventDefault();
            const statusMsg = document.getElementById('status-msg');
            const btnSubmit = document.getElementById('btn-submit');

            btnSubmit.disabled = true;
            btnSubmit.textContent = 'Menyimpan...';

            const payload = {
                tanggal: document.getElementById('tanggal').value,
                nama_sppg: document.getElementById('nama_sppg').value,
                yayasan: document.getElementById('yayasan').value,
                makanan_pokok: document.getElementById('makanan_pokok').value,
                lauk_hewani: document.getElementById('lauk_hewani').value,
                lauk_nabati: document.getElementById('lauk_nabati').value,
                sayur: document.getElementById('sayur').value,
                buah: document.getElementById('buah').value,
                pelengkap: document.getElementById('pelengkap').value,
                foto: document.getElementById('foto').value,
                foto_list: document.getElementById('foto').value ? [document.getElementById('foto').value] : [],
                catatan: document.getElementById('catatan').value,
                gizi: {
                    pk: {
                        energi: document.getElementById('pk-energi').value || null,
                        protein: document.getElementById('pk-protein').value || null,
                        lemak: document.getElementById('pk-lemak').value || null,
                        karbohidrat: document.getElementById('pk-karbohidrat').value || null,
                        serat: document.getElementById('pk-serat').value || null
                    },
                    pb: {
                        energi: document.getElementById('pb-energi').value || null,
                        protein: document.getElementById('pb-protein').value || null,
                        lemak: document.getElementById('pb-lemak').value || null,
                        karbohidrat: document.getElementById('pb-karbohidrat').value || null,
                        serat: document.getElementById('pb-serat').value || null
                    }
                }
            };

            try {
                const response = await fetch('https://www.minduniverse.id/api/menu', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (!response.ok || !result.ok) throw new Error(result.message || 'Gagal menyimpan data');

                statusMsg.className = 'text-xs text-center p-3 rounded-xl bg-emerald-500/10 text-emerald-400 block';
                statusMsg.textContent = '✅ Data menu berhasil disimpan ke database Supabase!';
            } catch (err) {
                statusMsg.className = 'text-xs text-center p-3 rounded-xl bg-red-500/10 text-red-400 block';
                statusMsg.textContent = '❌ Error: ' + err.message;
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.textContent = 'Simpan Menu ke Database';
            }
        });
    </script>
</body>
</html>
